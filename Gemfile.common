source 'https://rubygems.org'

gem 'rails', :path => '.'

gem 'rack', :path => 'rack'

gem 'rdoc', '=2.5.11'
gem 'mocha', '=0.9.7'
gem 'RedCloth'
gem 'memcache-client'
gem 'fcgi'

# Rack
gem 'bacon'
gem 'thin'

if RUBY_VERSION < '2'
  gem 'daemons', '< 1.4'
end

if RUBY_VERSION >= '2'
  gem 'webrick'
end

if RUBY_VERSION < '2'
  gem 'mongrel'
end

if RUBY_VERSION >= '3'
  gem 'rexml'
  gem 'net-smtp'
  gem 'ruby3-backward-compatibility'
end

if RUBY_VERSION >= '2.6'
  gem 'sqlite3', '=1.4.2'
else
  gem 'sqlite3', '=1.3.13'
end

if RUBY_VERSION >= '2.7'
  gem 'mysql2'
elsif RUBY_VERSION >= '2.4'
  # "mysql" will not compile any more
  # "mysql2" 0.3+ does not support Rails 2.3 (missing activerecord-mysql2-adapter)
  gem 'mysql2', :git => 'https://github.com/makandra/mysql2', :branch => '0.2.x-lts'
else
  gem 'mysql'
end

if RUBY_VERSION >= '3'
  gem 'pg'
  gem 'nokogiri', '=1.13.6'
  # From 3.6.3 on, test-unit prints every test's elapsed time in verbose mode.
  # mocha 0.9.7 replaces Test::Unit::TestCase#run with a copy that never records
  # one, so the runner dies with "can't convert nil into Float". 3.6.2 is what
  # the Ruby 3.1 and 3.3 lockfiles hold anyway; lifting this pin means dealing
  # with mocha first.
  gem 'test-unit', '<= 3.6.2'
elsif RUBY_VERSION >= '2'
  # just to get some variety of rake versions in our tests
  if RUBY_VERSION >= '2.5'
    gem 'rake', '~> 12.0'
  else
    gem 'rake', '~> 10.4'
  end
  gem 'pg'
  gem 'nokogiri', '=1.8.0'
  gem 'test-unit'
else
  gem 'rake', '=0.8.7'
  gem 'pg', '=0.9.0'
  gem 'nokogiri', '=1.3.3'
end

if RUBY_VERSION >= '3.3'
  gem 'base64'
  gem 'bigdecimal'
  gem 'csv'
  gem 'drb'
  gem 'mutex_m'
  gem 'nkf'
  gem 'observer'
end

if RUBY_VERSION >= '4'
  # another batch of stdlib turned into bundled gems in Ruby 4.0
  gem 'benchmark'
  gem 'logger'
  gem 'ostruct'
  gem 'pstore'
end

gem 'libxml-ruby', '=3.0.0'
